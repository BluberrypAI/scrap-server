# backend/.env 로 복사해서 사용 (cp .env.example backend/.env)
# Docker 방식에서는 DATABASE_URL을 docker-compose.yml이 덮어쓰므로 아래 값과 무관함.

APP_ENV=local
DOCS_ENABLED=true

# --- DB: 하나만 주석 해제 ---
# 1) SQLite (설치 없음, 로컬 방식 기본값)
DATABASE_URL=sqlite+aiosqlite:///./local.db
# 2) 직접 설치한 PostgreSQL
# DATABASE_URL=postgresql+asyncpg://resource:resource@localhost:5432/resource
# 3) Azure Database for PostgreSQL (DB_SSL=require 필수)
# DATABASE_URL=postgresql+asyncpg://<user>:<password>@<server>.postgres.database.azure.com:5432/resource
DB_SSL=disable
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# 운영에서는 반드시 변경 (python -c "import secrets; print(secrets.token_urlsafe(32))")
JWT_SECRET=change-me
SESSION_SECRET=change-me

# 탈퇴 후 실제 삭제까지 유예 일수 (삭제 실행: cd backend && uv run python -m app.domains.users.purge)
WITHDRAWAL_GRACE_DAYS=30

# 소셜 로그인 콜백은 {BACKEND_URL}/api/v1/auth/{provider}/callback. 콘솔에 등록한 리디렉션 URI와 같아야 함
# 로컬에서는 브라우저를 http://localhost:5173 으로 열 것 (backend/README.md "프론트엔드와 함께 실행")
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=["http://localhost:5173"]

# 프론트엔드가 다른 도메인이면 COOKIE_SAMESITE=none, COOKIE_SECURE=true
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Google Cloud Console > API 및 서비스 > 사용자 인증 정보 > OAuth 클라이언트 ID (웹)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft Entra 관리 센터 > 앱 등록 (지원 계정: 모든 조직 디렉터리 및 개인 Microsoft 계정)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common

# AI 서버(ai 레포) 주소. 처리 경로 데모의 업체 검토·웹 조사에 씀 (예: http://localhost:8001)
AI_BASE_URL=

# 팀 문진 엔진 HTTP 주소
CLASSIFICATION_BASE_URL=
# scrap-ai와 같은 내부 검토 서비스 토큰
SCRAP_INTAKE_SERVICE_TOKEN=

# 문진 엔진(scrap-diagnosis) 주소와 /internal/v1 토큰 (엔진 ENGINE_SERVICE_TOKEN과 같은 값)
# docker compose --profile engine up 이면 api 컨테이너에 http://engine:8030이 들어감
DIAGNOSIS_ENGINE_URL=
ENGINE_SERVICE_TOKEN=
# SDK 중첩 재시도를 제거한 diagnosis 기준: 모델 60초 × 추출/응답 각 2회 + DB 여유.
# 모델 호출 대기를 바꾸면 함께 조정한다. 통합 구성은 scrap-infra에서 전달한다.
# 비우면 코드 기본값 200초(운영 기준: 모델 40초 × 4회 + 여유, App Service 상한 약 230초 미만).
DIAGNOSIS_ENGINE_TIMEOUT_SECONDS=300

# 선택: 카카오모빌리티 자동차 길찾기 REST API 키. 없으면 직선거리로 명시.
KAKAO_MOBILITY_REST_API_KEY=

OSRM_DEMO_ENABLED=false
